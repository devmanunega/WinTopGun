<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- configSections debe ser siempre el primer elemento hijo de <configuration> -->
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="WinTopGun.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <appSettings>
        <add key="Scraping:WaitTimeoutSeconds" value="60" />
        <add key="Scraping:ChromeDebuggerAddress" value="localhost:9222" />
        <add key="Scraping:HumanPauseMinMs" value="10000" />
        <add key="Scraping:HumanPauseMaxMs" value="20000" />
        <add key="Scraping:MatchPauseMinMs" value="3000" />
        <add key="Scraping:MatchPauseMaxMs" value="8000" />
    </appSettings>
    <userSettings>
        <WinTopGun.Properties.Settings>
            <setting name="RutaDatosExtraidos" serializeAs="String">
                <value />
            </setting>
        </WinTopGun.Properties.Settings>
    </userSettings>
</configuration>
